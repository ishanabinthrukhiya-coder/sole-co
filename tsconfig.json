{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/(shop)/about-us/page.js", "app/(shop)/Cart/page.js", "app/(shop)/contact-us/page.js", "app/(shop)/products/page.js", "app/(shop)/products/[id]/page.js", "app/api/products/[id]/route.js", "app/api/products/route.js", "app/Components/Footer.js", "app/Components/Navbar.js", "app/Components/Productcard.js", "app/Components/Searching.js", "app/Context/cartContext.js", "app/data/products.js", "app/Services/productservice.js", "app/layout.js", "app/page.js"  ],
  "exclude": ["node_modules"]
}
